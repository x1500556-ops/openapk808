# Vik808 configuration — copy to .env and fill in.

# --- The one brain (required) — any OpenAI-compatible endpoint ---
VIK808_LLM_API_KEY=sk-...
# VIK808_LLM_BASE_URL=https://api.openai.com/v1
# VIK808_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...            # fallback alias for VIK808_LLM_API_KEY

# --- Telegram onboarding + chat surface (required for `python main.py bot`) ---
VIK808_TELEGRAM_TOKEN=123456:ABC-...

# --- Composio backend (optional — real SDK, connected-app actions) ---
# VIK808_COMPOSIO_API_KEY=ak-...
# VIK808_COMPOSIO_ENTITY_ID=default

# --- Optional browser engine (Playwright) ---
# VIK808_BROWSER_ENABLED=1         # also: pip install playwright && playwright install chromium

# --- ClawHub skill sources (comma-separated tarballs containing SKILL.md) ---
# VIK808_CLAWHUB_SOURCES=https://codeload.github.com/x1500556-ops/awesome-openclaw-skills808/tar.gz/refs/heads/main

# --- Paths & tuning (defaults shown) ---
# VIK808_DATA_DIR=./data
# VIK808_SKILLS_DIR=./skills
# VIK808_PLUGINS_DIR=./plugins
# VIK808_KNOWLEDGE_ROOT=..          # OpenAPK repo root
# VIK808_HISTORY_LIMIT=20
# VIK808_MAX_TOOL_ROUNDS=5
# VIK808_KNOWLEDGE_HITS=4
